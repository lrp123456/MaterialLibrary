{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "content-collections": [
        "./.content-collections/generated"
      ]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "apps/web/.next/types/**/*.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/types/**/*.d.ts",
    "../../use-frame-cache.ts",
    "../../../shared/**/*.ts",
    "src/stores/timeline-store.ts",
    ".next/dev/types/**/*.ts",
    ".next*/types/**/*.ts",
    ".next*/dev/types/**/*.ts",
    ".next-build6/types/**/*.ts",
    ".next-build6/dev/types/**/*.ts",
    ".next-build7/types/**/*.ts",
    ".next-build7/dev/types/**/*.ts",
    ".next-build8/types/**/*.ts",
    ".next-build8/dev/types/**/*.ts",
    ".next-build9/types/**/*.ts",
    ".next-build9/dev/types/**/*.ts",
    ".next-build-ia/types/**/*.ts",
    ".next-build-ia/dev/types/**/*.ts",
    ".next-build-transition/types/**/*.ts",
    ".next-build-transition/dev/types/**/*.ts",
    ".next-build-transition2/types/**/*.ts",
    ".next-build-transition2/dev/types/**/*.ts",
    ".next-build10/types/**/*.ts",
    ".next-build10/dev/types/**/*.ts",
    ".next-build11/types/**/*.ts",
    ".next-build11/dev/types/**/*.ts",
    ".next-build12/types/**/*.ts",
    ".next-build12/dev/types/**/*.ts",
    ".next-build13/types/**/*.ts",
    ".next-build13/dev/types/**/*.ts",
    ".next-build20/types/**/*.ts",
    ".next-build20/dev/types/**/*.ts",
    ".next-build21/types/**/*.ts",
    ".next-build21/dev/types/**/*.ts",
    ".next-build22/types/**/*.ts",
    ".next-build22/dev/types/**/*.ts",
    ".next-build23/types/**/*.ts",
    ".next-build23/dev/types/**/*.ts",
    ".next-build24/types/**/*.ts",
    ".next-build24/dev/types/**/*.ts",
    ".next-build25/types/**/*.ts",
    ".next-build25/dev/types/**/*.ts",
    ".next-build26/types/**/*.ts",
    ".next-build26/dev/types/**/*.ts",
    ".next-build27/types/**/*.ts",
    ".next-build27/dev/types/**/*.ts",
    ".next-build28/types/**/*.ts",
    ".next-build28/dev/types/**/*.ts",
    ".next-build29/types/**/*.ts",
    ".next-build29/dev/types/**/*.ts",
    ".next-build30/types/**/*.ts",
    ".next-build30/dev/types/**/*.ts",
    ".next-build31/types/**/*.ts",
    ".next-build31/dev/types/**/*.ts",
    ".next-build32/types/**/*.ts",
