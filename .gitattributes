# 行尾规则：这台机器 core.autocrlf=true，没有本文件时 git 会把 shell 脚本
# 检出成 CRLF，WSL 里的 bash 直接报 `$'\r': command not found`（start.sh 曾因此无法停止服务）。
#
# 本文件自身也必须是 LF，否则规则行尾的 CR 可能干扰解析。
.gitattributes text eol=lf

# Shell 脚本必须 LF：WSL/Linux 的 bash 不认 CRLF。
*.sh    text eol=lf
*.bash  text eol=lf

# Windows 批处理/PowerShell 必须 CRLF。
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制，禁止任何换行转换。
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
*.zip   binary
