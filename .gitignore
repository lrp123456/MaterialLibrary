# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
*/node_modules/
*/*/node_modules/
package-lock.json.bak
.pnpm-store/
.yarn/

# ==========================================
# Sensitive Credentials & Secrets (Security Rule)
# ==========================================
.env
*.env
!.env.example
*.env.local
*.key
*credentials*
*secret*
!src/env-secrets.js
credentials/
_credentials_bundle/

# ==========================================
# Databases & Local Runtime Storage
# ==========================================
data/
*.db
*.db-shm
*.db-wal
*.sqlite
metadata.db

# ==========================================
# Large Binary Models, Weights & Media
# ==========================================
*.glb
*.gltf
*.pth
*.onnx
*.bin
*.param
tools/ncnn/
tools/pnnx/
web-pro/dist/
web-pro/public/assets-3d/
web-pro/public/models/
web-pro/public/sample-video.mp4
app-uniapp/dist/
app-uniapp/src_backup/
pack-studio/zip4j-build/
pack-studio/_shots/
pack-studio/*.apk
pack-studio/*.idsig
pack-studio/_dev_dcstorage.db

# ==========================================
# Build Artifacts & Archives
# ==========================================
*.zip
*.tar.gz
*.7z
dist/build/

# ==========================================
# Logs & Process IDs
# ==========================================
logs/
*.log
*.pid
_pids.txt
*.txt

# ==========================================
# Temporary Caches & IDE Files
# ==========================================
.cache/
.vite/
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.quarkclouddrive/

# ==========================================
# Local Scratch & Diagnostic Scripts
# ==========================================
_audit_*
_backup_*
_test_*
_strip_dup.js
scripts/_*
scripts/inspect_keys_wsl.py
scripts/strip-provider-keys.py
scripts/test_*
query_*
/test_*
patch_mls.js
cordis.patch.yml

# ==========================================
# Next.js build artifacts (编辑器子应用)
# 构建产物可达数百 MB 且含 source map，绝不入库。
# 注意：本机因批量删除保护使用 .next-buildN，必须用通配覆盖。
# ==========================================
.next/
.next-build*/
editor/apps/web/.next*/

# ==========================================
# WorkBuddy 本地记忆（含用户上下文，不入库）
# ==========================================
.workbuddy/

# ==========================================
# 隐藏目录（. 开头）一律不入库
# .git 不受影响；已在库中的隐藏目录需 git rm --cached 才停止跟踪
# ==========================================
.*/

# Pack Studio 运行时状态（含推送快照，不入库）
pack-studio/state/

# 逆向规格素材（182MB 二进制预设，只作依据不随仓库走）
_pr_pack/
