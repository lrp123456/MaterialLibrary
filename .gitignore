# ==========================================
# Next.js build artifacts (编辑器子应用)
# 构建产物可达数百 MB 且含 source map，绝不入库。
# 注意：本机因批量删除保护使用 .next-buildN，必须用通配覆盖。
# ==========================================
.next/
.next-build*/
editor/apps/web/.next*/

# ==========================================
# WorkBuddy 本地记忆（含用户上下文，不入库）
# ==========================================
.workbuddy/

# ==========================================
# 隐藏目录（. 开头）一律不入库
# .git 不受影响；已在库中的隐藏目录需 git rm --cached 才停止跟踪
# ==========================================
.*/

# Pack Studio 运行时状态（含推送快照，不入库）
pack-studio/state/

# 逆向规格素材（182MB 二进制预设，只作依据不随仓库走）
_pr_pack/

# 构建临时目录与上一版产物（回滚用，不入库）
web-pro/dist-*/

# 三模型评估的素材包（含 init.zip 24MB，只作本地评测依据）
test01/

# 管理台构建产物（esbuild 输出，hash 文件名每次构建都变，不随仓库走）
# 重建：node web/build.mjs
web/dist/

# OSS 临时调试脚本（历史上写过明文凭据，禁止入库；现改为读 OSS_AK / OSS_SK）
scripts/test_oss.js

# ==========================================
# AI 会话转录与随手笔记（历史上 sss123.md 含明文 NewAPI 密钥，禁止入库）
# 根目录临时编号笔记/会话导出一律不入库；正式文档请放 docs/ 并使用描述性文件名
# ==========================================
/sss*.md
/scratch*.md
/notes*.md
/tmp*.md
/draft*.md

# AI 编码工具的会话/状态导出
*.session.md
*.session.txt
