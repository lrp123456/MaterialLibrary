# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
*/node_modules/
*/*/node_modules/
package-lock.json.bak
.pnpm-store/
.yarn/

# ==========================================
# Sensitive Credentials & Secrets (Security Rule)
# ==========================================
.env
*.env
!.env.example
*.env.local
*.key
*credentials*
*secret*
!src/env-secrets.js
credentials/
_credentials_bundle/

