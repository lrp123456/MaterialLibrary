{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://material-library.local/schemas/clip-pack-manifest.v1.json",
  "title": "Clip Pack Manifest",
  "description": "剪辑板块声明式资源包清单。加载器在服务端扫描 data/clip-packs/*/manifest.json 时校验；校验失败拒绝加载。不执行任何第三方代码。",
  "type": "object",
  "required": ["schemaVersion", "id", "type", "name", "version", "license"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "清单格式版本。破坏性变更时递增，加载器按主版本兼容。"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*)+$",
      "minLength": 6,
      "maxLength": 96,
      "description": "反向域名式唯一标识，例如 com.mls.effect.glow。目录名必须与之一致。"
    },
    "type": {
      "enum": ["effect", "transition", "textTemplate", "lut", "sticker", "assetPack"],
      "description": "决定注册到编辑器的哪个面板与渲染通道。"
    },
    "name": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "语义化版本。同 id 高版本覆盖低版本。"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minEditor": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "要求的最低编辑器版本；不满足则灰显并提示升级。"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 24 },
      "maxItems": 16
    },
    "preview": {
      "type": "string",
      "pattern": "^[^/\\\\][^\\\\]*$",
      "description": "包内相对路径的预览图（png/jpg/webp）。禁止绝对路径与 .. 穿越。"
    },
    "params": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/param" },
      "description": "暴露给检查器的参数。key 在包内唯一，写入 effectPassGroups 的 uniforms。"
    },
    "render": {
      "type": "object",
      "required": ["passes"],
      "additionalProperties": false,
      "properties": {
        "passes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["shader"],
            "additionalProperties": false,
            "properties": {
              "shader": {
                "description": "两种写法：① 内置 shader id（如 gaussian-blur，当前 wasm 只注册了这一个）；② 包内相对路径的 .wgsl/.glsl/.frag（需重编 opencut-wasm 才会生效）。",
                "anyOf": [
                  { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                  { "type": "string", "pattern": "^[^/\\\\][^\\\\]*\\.(wgsl|glsl|frag)$" }
                ]
              },
              "uniforms": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "description": "uniform 名 → 取值表达式。$key 引用 params 中的 key，$time/$progress 为内置量。"
              }
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultDuration": { "type": "number", "minimum": 0.1, "maximum": 10, "default": 0.5 },
        "requiresBothSides": { "type": "boolean", "default": true }
      }
    },
    "textTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/param" }
        },
        "defaultText": { "$ref": "#/$defs/localized" },
        "inAnimation": { "type": "string", "enum": ["none", "fade", "slideUp", "slideDown", "bounce", "typewriter", "scalePop"] },
        "outAnimation": { "type": "string", "enum": ["none", "fade", "slideUp", "slideDown", "scalePop"] }
      }
    },
    "lut": {
      "type": "object",
      "required": ["size"],
      "additionalProperties": false,
      "properties": {
        "size": { "type": "integer", "enum": [17, 25, 32, 33, 64], "description": "3D LUT 边长。" },
        "file": { "type": "string", "pattern": "\\.(cube|png)$" }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "kind": { "enum": ["image", "video", "audio", "sticker", "font"] },
          "thumb": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "duration": { "type": "number", "minimum": 0 }
        }
      }
    },
    "license": {
      "type": "object",
      "required": ["type", "source"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["internal", "cc0", "cc-by", "commercial", "unknown"],
          "description": "internal=自研；unknown 仅允许内部使用，对外发布前必须补全。"
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "format": "uri" },
        "attribution": { "type": "string", "maxLength": 400 },
        "commercialUse": { "type": "boolean", "default": false }
      }
    },
    "author": { "type": "string", "maxLength": 80 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["effect", "transition"] } }, "required": ["type"] },
      "then": { "required": ["render"] }
    },
    {
      "if": { "properties": { "type": { "const": "transition" } }, "required": ["type"] },
      "then": { "required": ["transition"] }
    },
    {
      "if": { "properties": { "type": { "const": "textTemplate" } }, "required": ["type"] },
      "then": { "required": ["textTemplate"] }
    },
    {
      "if": { "properties": { "type": { "const": "lut" } }, "required": ["type"] },
      "then": { "required": ["lut"] }
    },
    {
      "if": { "properties": { "type": { "enum": ["sticker", "assetPack"] } }, "required": ["type"] },
      "then": { "required": ["assets"] }
    }
  ],
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["zh"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string", "minLength": 1, "maxLength": 80 },
        "en": { "type": "string", "maxLength": 80 }
      }
    },
    "param": {
      "type": "object",
      "required": ["key", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,31}$" },
        "type": { "enum": ["number", "boolean", "color", "enum", "string", "vec2"] },
        "label": { "$ref": "#/$defs/localized" },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "maxLength": 8 },
        "keyframable": { "type": "boolean", "default": false },
        "group": { "type": "string", "maxLength": 24 },
        "options": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": ["string", "number", "boolean"] },
              "label": { "$ref": "#/$defs/localized" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
          "then": { "required": ["options"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["number"] } }, "required": ["type"] },
          "then": { "required": ["default", "min", "max"] }
        }
      ]
    }
  }
}
