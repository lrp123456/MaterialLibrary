# Material Library Infrastructure Configuration (Phase 2)
# Copy this file to .env or source it in your environment

# PostgreSQL Configuration (pgvector/pgvector:pg16)
POSTGRES_DB=material_library
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/material_library

# Redis Configuration (redis:7-alpine with AOF)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Service Ports
ML_PORT=30001
WEBPRO_PORT=30002
EDITOR_PORT=3010
OPSHUB_PORT=3790
PACKSTUDIO_PORT=3789

# External Proxy for Oversea LLM / Video API (Default 100% Direct; only on-demand)
ML_EXTERNAL_PROXY_URL=http://127.0.0.1:7890

# ASR Endpoints (Host Machine / GPU Server)
ASR_HTTP_URL=http://192.168.1.107:9000
ASR_WS_URL=ws://127.0.0.1:10096
ASR_LOCAL_HTTP_URL=http://127.0.0.1:10095

# Sidecar Notifier Switch (1 to disable)
ML_DISABLE_SIDECAR_NOTIFIER=0
