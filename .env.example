# 复制本文件为 .env 后再填写。
# 本文件保持空白，可以提交。
# .env 含真实钥匙，已被 git 忽略，不要提交，也不要放进压缩包。

# 火山账号 AK/SK。豆包音乐和视觉 OpenAPI 签名用。不是方舟 API Key。
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
VOLC_REGION=cn-north-1
VOLC_AK=
VOLC_SK=
VOLC_MUSIC_AK=
VOLC_MUSIC_SK=

# 火山方舟 Bearer。生图、生视频用。多把钥匙写在下一行，英文逗号分隔。
ARK_API_KEY=
ARK_API_KEYS=

# 人像签名。不填时不会回退到上面的 AK。
PORTRAIT_AK=
PORTRAIT_SK=
ARK_PORTRAIT_AK=
ARK_PORTRAIT_SK=

# 本地 LiteLLM 网关。管理接口优先用 MASTER。
LITELLM_API_KEY=
LITELLM_API_KEYS=
LITELLM_MASTER_KEY=

AGNES_API_KEY=
AGNES_API_KEYS=

GEMINI_API_KEY=
GEMINI_API_KEYS=

GROQ_API_KEY=
GROQ_API_KEYS=

KILO_API_KEY=
KILO_API_KEYS=

MODELSCOPE_API_KEY=
MODELSCOPE_API_KEYS=

UMBRA_TOKEN=
CREATION_PUBLIC_TOKEN=

# New API 聚合网关（https://newapi.naite.cc），对话模型 gemini-4-argon 走这里
NEWAPI_BASE_URL=https://newapi.naite.cc/v1
NEWAPI_API_KEY=
NEWAPI_API_KEYS=

# 阿里云 OSS：对话图片超限时上传公网，供不支持 base64 的模型读取。
# 运行时以数据库 kv.oss_config 为准（优先级高于环境变量）；这里的值需自行 export 才生效。
OSS_REGION=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_AK=
OSS_SK=

ML_PORT=30001
WEB_PRO_PORT=30002

# ===== 部署地址（真实值只写本地 .env）=====
# 公网服务器主机（不带协议与端口）
PUBLIC_HOST=
# 完整 URL，例如 http://your-host:30001
PUBLIC_BASE_URL=
# NAS / 内网主机
NAS_HOST=
LAN_HOST=

# ===== 管理员账户（仅本地初始化/重置口令用）=====
ML_ADMIN_USER=
ML_ADMIN_PASSWORD=
