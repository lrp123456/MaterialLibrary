  background: #2563eb;
  color: #ffffff;
}
.refresh-pill-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.refresh-pill-btn:active {
  background: #e2e8f0;
}
.refresh-icon {
