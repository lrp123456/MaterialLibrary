  font-size: 22rpx;
  color: #64748b;
  margin-left: 2rpx;
}

/* 下拉菜单蒙层与气泡 */
.media-type-popover-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(15, 23, 42, 0.2);
}
.media-type-popover {
  position: absolute;
  left: 88rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.16);
  border: 1rpx solid #e2e8f0;
  padding: 12rpx;
  min-width: 280rpx;
}
.popover-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  transition: all 0.15s;
}
