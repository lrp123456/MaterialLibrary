}
.refresh-icon.spinning {
  animation: spin 1s linear infinite;
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.search-row {
  display: flex;
  align-items: center;
  padding: 8rpx 28rpx 16rpx;
  gap: 16rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 40rpx;
  padding: 0 24rpx;
  gap: 10rpx;
}
.search-icon {
  font-size: 30rpx;
  color: #94a3b8;
}
.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  color: #0f172a;
}
.sort-btn {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
  padding: 8rpx 4rpx;
}
/* 聚合下拉筛选条容器 */
.filter-bar-container {
  position: relative;
  z-index: 100;
  background: #f8fafc;
}
.filter-bar-scroll {
  white-space: nowrap;
  padding-bottom: 12rpx;
}
.filter-bar {
  display: flex;
  align-items: center;
  padding: 4rpx 28rpx;
  gap: 14rpx;
}
.dropdown-trigger {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  border: 1.5rpx solid #e2e8f0;
  font-size: 24rpx;
  color: #475569;
  gap: 6rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}
.dropdown-trigger.selected {
  background: #eff6ff;
  border-color: #93c5fd;
  color: #2563eb;
  font-weight: 600;
}
.dropdown-trigger.active {
  border-color: #2563eb;
  box-shadow: 0 2rpx 10rpx rgba(37, 99, 235, 0.18);
}
.trigger-label {
  font-size: 24rpx;
}
.trigger-arrow {
  font-size: 20rpx;
  color: #94a3b8;
  margin-left: 2rpx;
}
.dropdown-trigger.selected .trigger-arrow {
  color: #2563eb;
}
.reset-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #fef2f2;
  border: 1.5rpx solid #fecaca;
  flex-shrink: 0;
}
.reset-text {
  font-size: 22rpx;
  color: #ef4444;
  font-weight: 600;
}

/* 下拉多选面板遮罩与弹出层 */
.dropdown-panel-wrapper {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 995;
}
.dropdown-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(2px);
}
.dropdown-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 72vh;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 36rpx rgba(0, 0, 0, 0.16);
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  animation: panelSlideUp 0.25s ease-out;
}
@keyframes panelSlideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
.panel-header {
  padding: 32rpx 32rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-bottom: 1rpx solid #f1f5f9;
}
.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}
.panel-hint {
  font-size: 22rpx;
  color: #94a3b8;
}
.panel-options-scroll {
  max-height: 48vh;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}
.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.option-chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #334155;
  transition: all 0.18s ease;
}
.color-chip-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 1.5rpx solid rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}
.option-chip.checked {
  background: #eff6ff;
  border-color: #2563eb;
  color: #2563eb;
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(37, 99, 235, 0.16);
}
.opt-check {
  margin-right: 8rpx;
  font-weight: 800;
  font-size: 24rpx;
  color: #2563eb;
}
.opt-text {
  font-size: 26rpx;
}
.panel-footer {
  display: flex;
  padding: 20rpx 32rpx;
  gap: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}
.panel-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.panel-btn.reset {
  flex: 1;
  background: #f1f5f9;
  color: #64748b;
  font-weight: 600;
}
.panel-btn.confirm {
  flex: 2;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.35);
}
.grid-scroll {
  flex: 1;
  padding: 8rpx 20rpx 32rpx;
  box-sizing: border-box;
}
.date-group {
  margin-bottom: 12rpx;
}
.date-label {
  display: block;
  padding: 20rpx 4rpx 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}
.cards {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  box-sizing: border-box;
}
.card {
  width: calc(50% - 10rpx);
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
  transition: all 0.2s ease;
}
.card.selected {
  border: 2rpx solid #2563eb;
  box-shadow: 0 4rpx 18rpx rgba(37, 99, 235, 0.2);
}
.card:nth-child(2n) {
  margin-right: 0;
}
.select-checkbox {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}
.select-checkbox.checked {
  background: #2563eb;
  border-color: #ffffff;
}
.check-icon {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}
.card-media {
  position: relative;
  width: 100%;
  height: 0;
  overflow: hidden;
  background: #f1f5f9;
}
.card-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}
.card-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 700;
  letter-spacing: 2rpx;
}
.badge {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  background: rgba(99, 102, 241, 0.92);
  color: #fff;
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  z-index: 2;
  font-weight: 600;
}
.badge.wm {
  left: auto;
  right: 14rpx;
  background: rgba(217, 119, 6, 0.92);
}
.badge.trash-badge {
  background: rgba(244, 63, 94, 0.9);
  max-width: 60%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.badge.trash-badge.soon {
  background: rgba(185, 28, 28, 0.95);
}
.badge.trash-badge.missing {
  background: rgba(100, 116, 139, 0.92);
}
.badge.trash-remain {
  left: auto;
  right: 14rpx;
  background: rgba(15, 23, 42, 0.82);
}
.badge.trash-remain.soon {
  background: rgba(217, 119, 6, 0.95);
}
.badge.vid {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  background: rgba(30, 41, 59, 0.85);
  color: #fff;
  font-size: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  z-index: 2;
  font-weight: 600;
}
.badge.vid.ai {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.4);
}
.video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 1;
}
.play-bubble {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(15, 23, 42, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}
.play-icon {
  color: #ffffff;
  font-size: 28rpx;
  margin-left: 4rpx;
}
.card-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 36rpx 16rpx 14rpx;
  background: linear-gradient(transparent, rgba(15, 23, 42, 0.75));
  z-index: 2;
}
.cap-name {
  display: block;
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cap-tag {
  display: block;
  color: rgba(255, 255, 255, 0.78);
  font-size: 18rpx;
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.state-box {
  padding: 100rpx 0;
  text-align: center;
}
.state-text {
  font-size: 28rpx;
  color: #64748b;
}
.state-text.err {
  color: #dc2626;
}
.state-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
}
.state-link {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #2563eb;
  font-weight: 600;
}
.footer {
  text-align: center;
  padding: 32rpx 0 54rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
.loading-spinner-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx 0;
}
.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.loading-spinner-text {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}
.finished-text {
  font-size: 22rpx;
  color: #94a3b8;
}
.batch-bar {
  position: fixed;
  bottom: 36rpx;
  left: 28rpx;
  right: 28rpx;
  background: rgba(15, 23, 42, 0.94);
  backdrop-filter: blur(12px);
  border-radius: 999rpx;
  padding: 12rpx 16rpx 12rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.28);
  z-index: 990;
  animation: slideInUp 0.25s ease-out;
}
@keyframes slideInUp {
  from { transform: translateY(100rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.batch-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.batch-count {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}
.batch-clear {
  font-size: 22rpx;
  color: #94a3b8;
  padding: 6rpx 10rpx;
}
.batch-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
.batch-btn {
  background: linear-gradient(135deg, #2563eb, #6366f1);
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.4);
}
.batch-btn.ghost {
  background: rgba(59, 130, 246, 0.16);
  border: 1rpx solid rgba(147, 197, 253, 0.5);
  box-shadow: none;
}
.batch-btn.danger {
  background: linear-gradient(135deg, #f43f5e, #e11d48);
  box-shadow: 0 4rpx 14rpx rgba(244, 63, 94, 0.35);
}
.batch-btn-text {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* ========== 五大素材Tab横向滚动 ========== */
.seg-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

/* ========== 音乐卡片内容 ========== */
.music-media {
  background: linear-gradient(135deg, #312e81, #1e1b4b) !important;
}
.music-card-body {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.music-disc {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6366f1, #818cf8);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(99, 102, 241, 0.5);
}
.music-disc.playing {
  animation: rotateDisc 3s linear infinite;
}
@keyframes rotateDisc {
  to { transform: rotate(360deg); }
}
.music-icon-note {
  font-size: 44rpx;
}
.music-play-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.music-play-icon {
  font-size: 28rpx;
  color: #ffffff;
}

/* ========== 人像/单品卡片渲染 ========== */
.portrait-media {
  background: #f8fafc !important;
}
.furniture-media {
  background: #faf5ff !important;
}
.contain-img {
  object-fit: contain !important;
}
.card-img.contain-img {
  background: transparent;
}

/* ========== 分类角标（覆盖/补充.badge） ========== */
.badge.music-badge {
  background: rgba(99, 102, 241, 0.92);
}
.badge.portrait-badge {
  background: rgba(16, 185, 129, 0.92);
}
.badge.furn-badge {
  background: rgba(139, 92, 246, 0.88);
}

/* ========== 一级媒体 Tab ========== */
.nav-heading {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.5rpx;
}
.nav-sub {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 2rpx;
  max-width: 360rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.media-tabs {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 28rpx 12rpx;
  background: #f8fafc;
}
.media-tab {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.18s ease;
}
.media-tab.active {
  background: #3b82f6;
  border-color: #3b82f6;
  box-shadow: 0 6rpx 18rpx rgba(59, 130, 246, 0.24);
}
.media-tab-icon {
  font-size: 26rpx;
}
.media-tab-label {
  font-size: 25rpx;
  font-weight: 700;
  color: #475569;
}
.media-tab.active .media-tab-label {
  color: #ffffff;
}
.media-tab.active .media-tab-icon {
  filter: saturate(1.1);
}
.media-tab.trash-tab {
  position: relative;
  flex: 0 0 auto;
  padding: 0 18rpx;
}
.media-tab-badge {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 7rpx;
  border-radius: 999rpx;
  background: #f43f5e;
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 3rpx 8rpx rgba(244, 63, 94, 0.35);
}

/* ========== 二级板块 ========== */
.section-rail-wrap {
  background: #f8fafc;
  padding-bottom: 10rpx;
}
.section-rail {
  width: 100%;
  white-space: nowrap;
}
.section-rail-inner {
  display: inline-flex;
  gap: 14rpx;
  padding: 2rpx 28rpx 4rpx;
}
.section-card {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 22rpx 14rpx 16rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e6ebf2;
  box-shadow: 0 3rpx 10rpx rgba(15, 23, 42, 0.03);
  transition: all 0.18s ease;
}
.section-card.active {
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border-color: #93c5fd;
  box-shadow: 0 6rpx 16rpx rgba(59, 130, 246, 0.14);
}
.section-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  text-align: center;
  line-height: 52rpx;
}
.section-card.active .section-icon {
  background: #ffffff;
}
.section-meta {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.section-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
}
.section-card.active .section-label {
  color: #1d4ed8;
}
.section-desc {
  font-size: 18rpx;
  color: #94a3b8;
  white-space: nowrap;
}
.section-card.trash-source-card {
  padding-right: 20rpx;
}

/* ========== 快捷筛选 ========== */
.quick-filter-wrap {
  background: #f8fafc;
  padding-bottom: 8rpx;
}
.quick-filter-scroll {
  width: 100%;
  white-space: nowrap;
}
.quick-filter-inner {
  display: inline-flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 28rpx;
}
.quick-group {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}
.quick-title {
  font-size: 20rpx;
  font-weight: 700;
  color: #64748b;
  padding-right: 2rpx;
}
.quick-options {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.quick-chip {
  height: 50rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}
.quick-chip.checked {
  background: #eff6ff;
  border-color: #3b82f6;
}
.quick-chip-text {
  font-size: 21rpx;
  color: #475569;
}
.quick-chip.checked .quick-chip-text {
  color: #1d4ed8;
  font-weight: 600;
}
.filter-open-btn {
  flex: 0 0 auto;
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #0f172a;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}
.filter-open-btn.active {
  background: #3b82f6;
}
.filter-open-icon {
  font-size: 22rpx;
  color: #ffffff;
}
.filter-open-text {
  font-size: 21rpx;
  font-weight: 700;
  color: #ffffff;
}

/* ========== 已选筛选 ========== */
.active-filter-row {
  background: #f8fafc;
  padding-bottom: 8rpx;
}
.active-filter-scroll {
  width: 100%;
  white-space: nowrap;
}
.active-filter-inner {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 28rpx;
}
.active-filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
}
.active-filter-text {
  font-size: 20rpx;
  color: #1d4ed8;
}
.active-filter-x {
  font-size: 18rpx;
  color: #64748b;
}
.active-filter-clear {
  font-size: 20rpx;
  font-weight: 700;
  color: #3b82f6;
  padding: 0 12rpx;
}

/* ========== 筛选抽屉 ========== */
.filter-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.4);
  z-index: 900;
  display: flex;
  align-items: flex-end;
}
.filter-sheet {
  width: 100%;
  max-height: 76vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}
.filter-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 26rpx 28rpx 16rpx;
}
.filter-sheet-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}
.filter-sheet-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #94a3b8;
}
.filter-sheet-close {
  font-size: 30rpx;
  color: #64748b;
  padding: 0 6rpx;
}
.filter-sheet-body {
  max-height: 54vh;
  padding: 0 28rpx 16rpx;
}
.filter-group {
  padding: 16rpx 0 6rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.filter-group:last-child {
