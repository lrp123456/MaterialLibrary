  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
  padding: 10rpx 22rpx 10rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.05);
  transition: all 0.2s;
}
