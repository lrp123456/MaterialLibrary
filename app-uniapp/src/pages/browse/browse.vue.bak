  font-size: 24rpx;
  color: #2563eb;
  font-weight: bold;
}
.popover-item-badge {
  min-width: 34rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  text-align: center;
  line-height: 30rpx;
}
.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: -1rpx;
}
.nav-right-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.nav-action-btn {
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
